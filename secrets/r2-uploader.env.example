# Bucket-scoped Cloudflare R2 token for the drive uploader (deck/r2put.py).
# Copy to secrets/r2-uploader.env on the laptop, or ~/.scirocco-r2.env on the
# deck, and fill in real values. Object Read & Write, scoped to ONE bucket,
# TTL forever. See cloud/README.md "R2 token for the car uploader".
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=scirocco-drives
